# Generated from lab secrets with: python3 tools/configure_cloud.py
LAB_GROUP_ID=YOUR_UNIQUE_GROUP_ID
INFLUX_URL=https://YOUR_REGION.aws.cloud2.influxdata.com
INFLUX_ORG=YOUR_ORG_ID
INFLUX_BUCKET=environment_lab
INFLUX_TOKEN=YOUR_BUCKET_WRITE_TOKEN
# Grafana requires bucket READ permission. Can be the same token if read/write.
INFLUX_READ_TOKEN=YOUR_BUCKET_READ_TOKEN
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
